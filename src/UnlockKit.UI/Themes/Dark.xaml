<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Dark theme. Same keys as Light.xaml — anything missing here resolves to
         nothing, so the two files must stay in lockstep. -->

    <SolidColorBrush x:Key="Window.Background" Color="#14161B"/>

    <SolidColorBrush x:Key="Surface" Color="#1A1D24"/>
    <SolidColorBrush x:Key="Surface.Alt" Color="#1E222A"/>

    <SolidColorBrush x:Key="Border" Color="#2C313B"/>
    <SolidColorBrush x:Key="Border.Strong" Color="#3A404D"/>

    <SolidColorBrush x:Key="Text" Color="#E7E9EF"/>
    <SolidColorBrush x:Key="Text.Muted" Color="#98A0B0"/>
    <SolidColorBrush x:Key="Text.Header" Color="#9AA3B2"/>

    <SolidColorBrush x:Key="Accent" Color="#6366F1"/>
    <SolidColorBrush x:Key="Accent.Hover" Color="#7C7FF5"/>
    <SolidColorBrush x:Key="Accent.Text" Color="#FFFFFF"/>

    <SolidColorBrush x:Key="Danger" Color="#D93A3A"/>
    <SolidColorBrush x:Key="Danger.Hover" Color="#E85B5B"/>

    <SolidColorBrush x:Key="Button.Background" Color="#232833"/>
    <SolidColorBrush x:Key="Button.Hover" Color="#2C3240"/>
    <SolidColorBrush x:Key="Button.Pressed" Color="#191D25"/>

    <SolidColorBrush x:Key="Selection" Color="#2B3244"/>
    <SolidColorBrush x:Key="Header.Background" Color="#1E222A"/>

    <SolidColorBrush x:Key="Scroll.Thumb" Color="#3B4250"/>
    <SolidColorBrush x:Key="Scroll.Thumb.Hover" Color="#4E5768"/>

    <SolidColorBrush x:Key="Verdict.Ok" Color="#4ADE80"/>
    <SolidColorBrush x:Key="Verdict.Warn" Color="#F5B942"/>
    <SolidColorBrush x:Key="Verdict.Bad" Color="#FF7F7F"/>
    <SolidColorBrush x:Key="Verdict.Neutral" Color="#9AA2B1"/>

</ResourceDictionary>
