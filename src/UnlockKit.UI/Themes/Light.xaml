<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Light theme. Only raw colours live here; Controls.xaml owns every
         style and refers to these keys with DynamicResource, so swapping this
         dictionary repaints the whole window without touching a single
         control instance. -->

    <SolidColorBrush x:Key="Window.Background" Color="#F4F5F9"/>

    <SolidColorBrush x:Key="Surface" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Surface.Alt" Color="#FAFBFD"/>

    <SolidColorBrush x:Key="Border" Color="#E2E6F0"/>
    <SolidColorBrush x:Key="Border.Strong" Color="#D5DAE5"/>

    <SolidColorBrush x:Key="Text" Color="#1F2430"/>
    <SolidColorBrush x:Key="Text.Muted" Color="#6B7280"/>
    <SolidColorBrush x:Key="Text.Header" Color="#4B5563"/>

    <SolidColorBrush x:Key="Accent" Color="#4F46E5"/>
    <SolidColorBrush x:Key="Accent.Hover" Color="#4338CA"/>
    <SolidColorBrush x:Key="Accent.Text" Color="#FFFFFF"/>

    <SolidColorBrush x:Key="Danger" Color="#DC2626"/>
    <SolidColorBrush x:Key="Danger.Hover" Color="#B91C1C"/>

    <SolidColorBrush x:Key="Button.Background" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Button.Hover" Color="#EEF0F7"/>
    <SolidColorBrush x:Key="Button.Pressed" Color="#DDE2EE"/>

    <SolidColorBrush x:Key="Selection" Color="#EEF0F7"/>
    <SolidColorBrush x:Key="Header.Background" Color="#F1F3F9"/>

    <SolidColorBrush x:Key="Scroll.Thumb" Color="#C9CFDB"/>
    <SolidColorBrush x:Key="Scroll.Thumb.Hover" Color="#AAB2C2"/>

    <SolidColorBrush x:Key="Verdict.Ok" Color="#2E8B57"/>
    <SolidColorBrush x:Key="Verdict.Warn" Color="#C2760B"/>
    <SolidColorBrush x:Key="Verdict.Bad" Color="#B22222"/>
    <SolidColorBrush x:Key="Verdict.Neutral" Color="#6B7280"/>

</ResourceDictionary>
