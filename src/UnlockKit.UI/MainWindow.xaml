<Window x:Class="UnlockKit.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="UnlockKit" Width="820" Height="620"
        MinWidth="680" MinHeight="500"
        Icon="Assets/unlockkit.ico"
        Background="#F5F6FA"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13">
    <Window.Resources>
        <!-- base button: flat, rounded, subtle border -->
        <Style x:Key="Btn" TargetType="Button">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#1F2430"/>
            <Setter Property="BorderBrush" Value="#D5DAE5"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#DDE2EE"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#EEF0F7"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="BtnPrimary" TargetType="Button" BasedOn="{StaticResource Btn}">
            <Setter Property="Background" Value="#4F46E5"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#4F46E5"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#4338CA"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="BtnDanger" TargetType="Button" BasedOn="{StaticResource Btn}">
            <Setter Property="Background" Value="#DC2626"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#DC2626"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#B91C1C"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- path input -->
        <Style x:Key="Input" TargetType="TextBox">
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#D5DAE5"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter Property="BorderBrush" Value="#4F46E5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- clean data grid -->
        <Style x:Key="GridCell" TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,4"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#EEF0F7"/>
                    <Setter Property="Foreground" Value="#1F2430"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="GridHeader" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F1F3F9"/>
            <Setter Property="Foreground" Value="#4B5563"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="8,7"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="#E2E6F0"/>
        </Style>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="118"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- path picker -->
        <DockPanel Grid.Row="0" Margin="0,0,0,10">
            <Button Content="Folder…" Click="BrowseFolder" Style="{StaticResource Btn}"
                    DockPanel.Dock="Right" Margin="6,0,0,0"/>
            <Button Content="File…" Click="BrowseFile" Style="{StaticResource Btn}"
                    DockPanel.Dock="Right" Margin="6,0,0,0"/>
            <TextBox Text="{Binding TargetPath, UpdateSourceTrigger=PropertyChanged}"
                     Style="{StaticResource Input}"/>
        </DockPanel>

        <!-- verdict banner -->
        <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#E2E6F0" BorderThickness="1"
                CornerRadius="6" Padding="12,9" Margin="0,0,0,10">
            <DockPanel>
                <Border DockPanel.Dock="Left" Width="4" CornerRadius="2"
                        Background="{Binding VerdictBrush}" Margin="0,0,10,0"/>
                <TextBlock Text="{Binding Verdict}" Foreground="{Binding VerdictBrush}"
                           FontWeight="SemiBold" TextWrapping="Wrap"
                           VerticalAlignment="Center"/>
            </DockPanel>
        </Border>

        <!-- lockers -->
        <DataGrid Grid.Row="2" ItemsSource="{Binding Lockers}"
                  AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                  HeadersVisibility="Column" GridLinesVisibility="None"
                  RowBackground="#FFFFFF" AlternatingRowBackground="#FAFBFD"
                  Background="#FFFFFF" BorderBrush="#E2E6F0" BorderThickness="1"
                  HorizontalGridLinesBrush="#F1F3F9"
                  SelectionMode="Single" SelectionUnit="FullRow"
                  ColumnHeaderStyle="{StaticResource GridHeader}"
                  CellStyle="{StaticResource GridCell}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Process" Binding="{Binding Name}" Width="*"/>
                <DataGridTextColumn Header="PID" Binding="{Binding Pid}" Width="70"/>
                <DataGridTextColumn Header="Handles" Binding="{Binding Handles}" Width="70"/>
                <DataGridTextColumn Header="Access" Binding="{Binding Access}" Width="*"/>
                <DataGridTextColumn Header="Held files" Binding="{Binding Files}" Width="1.6*"/>
                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="80"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- primary actions -->
        <WrapPanel Grid.Row="3" Margin="0,10,0,0">
            <Button Content="Scan" Command="{Binding ScanCommand}" Style="{StaticResource BtnPrimary}"
                    Margin="0,0,8,0"/>
            <Button Content="Unlock" Command="{Binding CloseCommand}" Style="{StaticResource Btn}"
                    Margin="0,0,8,0"/>
            <Button Content="Delete" Command="{Binding DeleteCommand}" Style="{StaticResource BtnDanger}"
                    Margin="0,0,8,0"/>
            <Button Content="Delete on reboot" Command="{Binding RebootCommand}" Style="{StaticResource Btn}"
                    Margin="0,0,8,0"/>
            <Button Content="End processes" Command="{Binding KillCommand}" Style="{StaticResource Btn}"/>
        </WrapPanel>

        <!-- shell / elevation -->
        <DockPanel Grid.Row="4" Margin="0,8,0,0" LastChildFill="False">
            <Button Content="{Binding MenuCaption}" Command="{Binding MenuCommand}"
                    Style="{StaticResource Btn}" DockPanel.Dock="Left"/>
            <Button Content="Restart as administrator" Command="{Binding ElevateCommand}"
                    Style="{StaticResource Btn}" DockPanel.Dock="Right"/>
        </DockPanel>

        <!-- log -->
        <TextBox Grid.Row="5" Margin="0,10,0,0" IsReadOnly="True"
                 Text="{Binding LogText, Mode=OneWay}" FontFamily="Cascadia Mono, Consolas" FontSize="11"
                 Style="{StaticResource Input}" TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto"/>

        <!-- status bar -->
        <DockPanel Grid.Row="6" Margin="0,8,0,0">
            <TextBlock Text="{Binding ElevationHint}" DockPanel.Dock="Right" Foreground="#6B7280"/>
            <TextBlock Text="{Binding Status}" Foreground="#6B7280"/>
        </DockPanel>
    </Grid>
</Window>
