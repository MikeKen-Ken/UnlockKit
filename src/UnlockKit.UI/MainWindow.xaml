<Window x:Class="UnlockKit.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="UnlockKit" Width="820" Height="620"
        MinWidth="680" MinHeight="500"
        Icon="Assets/unlockkit.ico"
        Background="{DynamicResource Window.Background}"
        Foreground="{DynamicResource Text}"
        Loaded="OnLoaded"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13">

    <!-- No styles here: Themes/Controls.xaml owns them all, which is what lets
         the light/dark switch work without touching this file. -->

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="118"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- path picker -->
        <DockPanel Grid.Row="0" Margin="0,0,0,10">
            <Button Content="Folder…" Click="BrowseFolder" Style="{StaticResource Btn}"
                    DockPanel.Dock="Right" Margin="6,0,0,0"/>
            <Button Content="File…" Click="BrowseFile" Style="{StaticResource Btn}"
                    DockPanel.Dock="Right" Margin="6,0,0,0"/>
            <TextBox Text="{Binding TargetPath, UpdateSourceTrigger=PropertyChanged}"
                     Style="{StaticResource Input}"/>
        </DockPanel>

        <!-- verdict banner -->
        <Border Grid.Row="1" Background="{DynamicResource Surface}"
                BorderBrush="{DynamicResource Border}" BorderThickness="1"
                CornerRadius="6" Padding="12,9" Margin="0,0,0,10">
            <DockPanel>
                <Border DockPanel.Dock="Left" Width="4" CornerRadius="2"
                        Background="{Binding VerdictBrush}" Margin="0,0,10,0"/>
                <TextBlock Text="{Binding Verdict}" Foreground="{Binding VerdictBrush}"
                           FontWeight="SemiBold" TextWrapping="Wrap"
                           VerticalAlignment="Center"/>
            </DockPanel>
        </Border>

        <!-- lockers -->
        <DataGrid Grid.Row="2" ItemsSource="{Binding Lockers}"
                  AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                  HeadersVisibility="Column" GridLinesVisibility="None"
                  RowBackground="{DynamicResource Surface}"
                  AlternatingRowBackground="{DynamicResource Surface.Alt}"
                  Background="{DynamicResource Surface}"
                  Foreground="{DynamicResource Text}"
                  BorderBrush="{DynamicResource Border}" BorderThickness="1"
                  HorizontalGridLinesBrush="{DynamicResource Border}"
                  SelectionMode="Single" SelectionUnit="FullRow"
                  ColumnHeaderStyle="{StaticResource GridHeader}"
                  CellStyle="{StaticResource GridCell}"
                  RowStyle="{StaticResource GridRow}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Process" Binding="{Binding Name}" Width="*"/>
                <DataGridTextColumn Header="PID" Binding="{Binding Pid}" Width="70"/>
                <DataGridTextColumn Header="Handles" Binding="{Binding Handles}" Width="70"/>
                <DataGridTextColumn Header="Access" Binding="{Binding Access}" Width="*"/>
                <DataGridTextColumn Header="Held files" Binding="{Binding Files}" Width="1.6*"/>
                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="80"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- primary actions -->
        <WrapPanel Grid.Row="3" Margin="0,10,0,0">
            <Button Content="Scan" Command="{Binding ScanCommand}" Style="{StaticResource BtnPrimary}"
                    Margin="0,0,8,0"/>
            <Button Content="Unlock" Command="{Binding CloseCommand}" Style="{StaticResource Btn}"
                    Margin="0,0,8,0"/>
            <Button Content="Delete" Command="{Binding DeleteCommand}" Style="{StaticResource BtnDanger}"
                    Margin="0,0,8,0"/>
            <Button Content="Delete on reboot" Command="{Binding RebootCommand}" Style="{StaticResource Btn}"
                    Margin="0,0,8,0"/>
            <Button Content="End processes" Command="{Binding KillCommand}" Style="{StaticResource Btn}"/>
        </WrapPanel>

        <!-- shell / elevation -->
        <DockPanel Grid.Row="4" Margin="0,8,0,0" LastChildFill="False">
            <Button Content="{Binding MenuCaption}" Command="{Binding MenuCommand}"
                    Style="{StaticResource Btn}" DockPanel.Dock="Left"/>
            <Button Content="Restart as administrator" Command="{Binding ElevateCommand}"
                    Style="{StaticResource Btn}" DockPanel.Dock="Right"/>
        </DockPanel>

        <!-- update banner: only shown when a download finished and the daily
             reminder has not been used yet -->
        <Border Grid.Row="5" Background="{DynamicResource Surface}"
                BorderBrush="{DynamicResource Border}" BorderThickness="1"
                CornerRadius="6" Padding="12,9" Margin="0,10,0,0"
                ToolTip="{Binding UpdateNotes}"
                Visibility="{Binding UpdateBannerVisible, Converter={StaticResource BoolToVis}}">
            <DockPanel>
                <Border DockPanel.Dock="Left" Width="4" CornerRadius="2"
                        Background="{DynamicResource Accent}" Margin="0,0,10,0"/>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Restart and update" Command="{Binding UpdateInstallCommand}"
                            Style="{StaticResource BtnPrimary}" Margin="10,0,0,0"/>
                    <Button Content="Later" Command="{Binding UpdateLaterCommand}"
                            Style="{StaticResource Btn}" Margin="8,0,0,0"/>
                    <Button Content="Skip" Command="{Binding UpdateSkipCommand}"
                            Style="{StaticResource BtnGhost}" Margin="6,0,0,0"
                            ToolTip="Never prompt for this version again"/>
                </StackPanel>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding UpdateHeadline}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding UpdateDetail}" Foreground="{DynamicResource Text.Muted}"
                               TextWrapping="Wrap" Margin="0,2,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- log -->
        <TextBox Grid.Row="6" Margin="0,10,0,0" IsReadOnly="True"
                 Text="{Binding LogText, Mode=OneWay}" FontFamily="Cascadia Mono, Consolas" FontSize="11"
                 Style="{StaticResource Input}" TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto"/>

        <!-- status bar -->
        <DockPanel Grid.Row="7" Margin="0,8,0,0">
            <Button DockPanel.Dock="Right" Style="{StaticResource BtnGhost}" Margin="10,0,0,0"
                    Command="{Binding ThemeCommand}" ToolTip="{Binding ThemeTip}">
                <Button.ContextMenu>
                    <ContextMenu DataContext="{Binding PlacementTarget.DataContext,
                                               RelativeSource={RelativeSource Self}}">
                        <MenuItem Header="Light" Command="{Binding ThemeLightCommand}"/>
                        <MenuItem Header="Dark" Command="{Binding ThemeDarkCommand}"/>
                        <Separator/>
                        <MenuItem Header="Follow Windows" Command="{Binding ThemeSystemCommand}"/>
                    </ContextMenu>
                </Button.ContextMenu>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding ThemeGlyph}" Margin="0,0,6,0"
                               FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                               FontSize="13" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding ThemeLabel}" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>

            <!-- manual update entry point; doubles as the download progress readout -->
            <Button DockPanel.Dock="Right" Style="{StaticResource BtnGhost}" Margin="10,0,0,0"
                    Command="{Binding UpdateCommand}" ToolTip="{Binding UpdateTip}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding UpdateGlyph}" Margin="0,0,6,0"
                               FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                               FontSize="13" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding UpdateLabel}" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>

            <TextBlock Text="{Binding ElevationHint}" DockPanel.Dock="Right"
                       Foreground="{DynamicResource Text.Muted}" VerticalAlignment="Center"/>
            <TextBlock Text="{Binding Status}" Foreground="{DynamicResource Text.Muted}"
                       VerticalAlignment="Center"/>
        </DockPanel>
    </Grid>
</Window>
